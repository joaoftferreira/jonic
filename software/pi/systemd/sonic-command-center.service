# System service: the Flask server that hosts the phone remote, the LCD page
# and the WebSocket between them. Install to /etc/systemd/system/.
#
#   sudo cp systemd/sonic-command-center.service /etc/systemd/system/
#   sudo systemctl enable --now sonic-command-center
#
# It does not need the desktop, and it must not wait for the broker: the eyes
# have to come up whether or not an ESP32 or mosquitto is running.
[Unit]
Description=Sonic Command Center
After=network-online.target
Wants=network-online.target

[Service]
User=kam
WorkingDirectory=/home/kam/EProjects/jonic/software/pi
ExecStart=/usr/bin/python3 -m command_center.app
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
